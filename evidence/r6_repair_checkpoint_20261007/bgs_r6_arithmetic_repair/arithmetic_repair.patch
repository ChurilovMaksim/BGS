@@ -0,0 +1,365 @@
+"""Bounded input-contract and representative-invariance regressions.
+
+These tests check exact discrete inputs and finite complex128 agreement. They
+are not a theorem audit or evidence of any asymptotic spectral law. unittest
+checks remain effective with Python optimization enabled.
+"""
+from __future__ import annotations
+
+from fractions import Fraction
+from pathlib import Path
+import sys
+import unittest
+import warnings
+
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(ROOT / "computations" / "python"))
+from bgs import jacobi as ja
+from bgs import magnetic_quotient as mq
+from bgs import twisted_jacobi as tj
+from bgs.finite_field import primitive_root
+
+BAD_TYPES = (
+    True, False, np.bool_(True), 1.0, 1.5, np.float64(1.9),
+    "1", None, 1+0j, Fraction(1, 1),
+)
+
+
+class MagneticIntegerContracts(unittest.TestCase):
+    def setUp(self):
+        self.p, self.K, self.h = 7, 3, 2
+        self.H = (1, 2, 4)
+        self.log = ja.dlog_table(self.p, 3)
+        self.indices = np.array([3], dtype=np.int64)
+        self.C = mq.word_histogram(self.p, self.H, 2)
+
+    def prime_calls(self, p):
+        return (
+            ("subgroup", lambda: mq.subgroup(p, self.K, self.h)),
+            ("orbit_coordinates", lambda: mq.orbit_coordinates(p, self.H)),
+            ("orbit_matrix", lambda: mq.orbit_matrix(p, self.H, 1)),
+            ("orbit_basis", lambda: mq.orbit_basis(p, self.H)),
+            ("gauss_real_gauge", lambda: mq.gauss_real_gauge(p, self.log, self.indices, 1)),
+            ("word_histogram", lambda: mq.word_histogram(p, self.H, 2)),
+            ("canonical_histogram", lambda: mq.canonical_histogram(p, self.C)),
+            ("histogram_trace", lambda: mq.histogram_trace(p, self.K, 2, 1, self.C)),
+            ("mean_trace", lambda: mq.mean_trace(p, self.K, 2, self.C)),
+        )
+
+    def subgroup_calls(self, H):
+        return (
+            ("orbit_coordinates", lambda: mq.orbit_coordinates(self.p, H)),
+            ("orbit_matrix", lambda: mq.orbit_matrix(self.p, H, 1)),
+            ("orbit_basis", lambda: mq.orbit_basis(self.p, H)),
+            ("word_histogram", lambda: mq.word_histogram(self.p, H, 2)),
+        )
+
+    def test_invalid_prime_types_and_domains(self):
+        probes = [(value, True) for value in BAD_TYPES] + [(value, False) for value in (0, -7, 2, 9)]
+        for p, invalid_type in probes:
+            for name, call in self.prime_calls(p):
+                with self.subTest(p=repr(p), api=name):
+                    failure = (self.assertRaisesRegex(ValueError, "must be an integer")
+                               if invalid_type else self.assertRaises(ValueError))
+                    with failure:
+                        call()
+
+    def test_invalid_scalar_types(self):
+        for bad in BAD_TYPES:
+            cases = (
+                ("subgroup.K", lambda: mq.subgroup(self.p, bad, self.h)),
+                ("subgroup.h", lambda: mq.subgroup(self.p, self.K, bad)),
+                ("word_histogram.m", lambda: mq.word_histogram(self.p, self.H, bad)),
+                ("histogram_trace.K", lambda: mq.histogram_trace(self.p, bad, 2, 1, self.C)),
+                ("histogram_trace.m", lambda: mq.histogram_trace(self.p, self.K, bad, 1, self.C)),
+                ("mean_trace.K", lambda: mq.mean_trace(self.p, bad, 2, self.C)),
+                ("mean_trace.m", lambda: mq.mean_trace(self.p, self.K, bad, self.C)),
+                ("orbit_matrix.q", lambda: mq.orbit_matrix(self.p, self.H, bad)),
+                ("histogram_trace.q", lambda: mq.histogram_trace(self.p, self.K, 2, bad, self.C)),
+                ("gauss_real_gauge.q", lambda: mq.gauss_real_gauge(self.p, self.log, self.indices, bad)),
+            )
+            for name, call in cases:
+                with self.subTest(value=repr(bad), argument=name):
+                    with self.assertRaisesRegex(ValueError, "must be an integer"):
+                        call()
+
+    def test_invalid_H_and_indices(self):
+        for bad in BAD_TYPES:
+            for name, call in self.subgroup_calls((1, 2, bad)):
+                with self.subTest(value=repr(bad), api=name):
+                    with self.assertRaisesRegex(ValueError, "must be an integer"):
+                        call()
+            with self.subTest(value=repr(bad), argument="indices"):
+                with self.assertRaisesRegex(ValueError, "must be an integer"):
+                    mq.gauss_real_gauge(self.p, self.log, [3, bad], 1)
+        for H in ((), (0,), (self.p-1,), [[1, 2, 4]], np.array(1), None):
+            for name, call in self.subgroup_calls(H):
+                with self.subTest(H=repr(H), api=name):
+                    with self.assertRaises(ValueError):
+                        call()
+        for indices in ([[3]], np.array(3), None, [0], [self.p-1]):
+            with self.subTest(indices=repr(indices)):
+                with self.assertRaises(ValueError):
+                    mq.gauss_real_gauge(self.p, self.log, indices, 1)
+
+    def test_dlog_validation_preserves_entry_types(self):
+        for bad in BAD_TYPES:
+            table = self.log.tolist()
+            table[1] = bad
+            with self.subTest(value=repr(bad)):
+                with self.assertRaisesRegex(ValueError, "must be an integer"):
+                    mq.gauss_real_gauge(self.p, table, self.indices, 1)
+        negative = self.log.copy()
+        negative[1] = -1
+        too_large = self.log.copy()
+        too_large[1] = self.p-1
+        for table in (self.log[:-1], self.log.reshape(1, -1), negative, too_large):
+            # Shape/type/range is checked; arbitrary range-valid entries are
+            # not certified as genuine discrete logarithms by these helpers.
+            with self.subTest(shape=np.shape(table)):
+                with self.assertRaises(ValueError):
+                    mq.gauss_real_gauge(self.p, table, self.indices, 1)
+
+    def test_zero_residues_and_nonpositive_orders(self):
+        for q in (0, self.p, -self.p, np.int64(self.p * 2**50)):
+            for name, call in (
+                ("matrix", lambda: mq.orbit_matrix(self.p, self.H, q)),
+                ("histogram", lambda: mq.histogram_trace(self.p, self.K, 2, q, self.C)),
+                ("gauge", lambda: mq.gauss_real_gauge(self.p, self.log, self.indices, q)),
+            ):
+                with self.subTest(q=repr(q), api=name):
+                    with self.assertRaises(ValueError):
+                        call()
+        for bad in (0, -1):
+            for call in (
+                lambda: mq.word_histogram(self.p, self.H, bad),
+                lambda: mq.histogram_trace(self.p, bad, 2, 1, self.C),
+                lambda: mq.histogram_trace(self.p, self.K, bad, 1, self.C),
+                lambda: mq.mean_trace(self.p, bad, 2, self.C),
+                lambda: mq.mean_trace(self.p, self.K, bad, self.C),
+            ):
+                with self.assertRaises(ValueError):
+                    call()
+        for K in (0, -1, 2, 5):
+            with self.assertRaises(ValueError):
+                mq.subgroup(self.p, K, self.h)
+
+    def test_numpy_integers_and_subgroup_representatives(self):
+        p, K, h = np.int64(199), np.int64(11), np.int64(139)
+        expected_H = mq.subgroup(int(p), int(K), int(h))
+        for generator in (h, int(h)+int(p)*10**80, int(h)-int(p)*10**80):
+            H = mq.subgroup(p, K, generator)
+            self.assertEqual(H, expected_H)
+            self.assertTrue(all(type(x) is int for x in H))
+        expected_C = mq.word_histogram(199, expected_H, 2)
+        expected_coords = mq.orbit_coordinates(199, expected_H)
+        expected_basis = mq.orbit_basis(199, expected_H)
+        variants = (
+            np.array(expected_H, dtype=np.int64),
+            np.array(expected_H, dtype=np.uint64),
+            tuple(x+199*10**80 for x in expected_H),
+            tuple(x-199*10**80 for x in expected_H),
+            np.array([x+199*2**50 for x in expected_H], dtype=np.int64),
+            np.array([x+199*((-1)**i)*10**80 for i, x in enumerate(expected_H)], dtype=object),
+            np.array([x+199*2**56 for x in expected_H], dtype=np.uint64),
+        )
+        for H in variants:
+            before = H.copy() if isinstance(H, np.ndarray) else H
+            with self.subTest(H_type=type(H).__name__):
+                self.assertEqual(mq.word_histogram(p, H, np.int64(2)), expected_C)
+                coords = mq.orbit_coordinates(p, H)
+                for observed, expected in zip(coords, expected_coords):
+                    np.testing.assert_array_equal(observed, expected)
+                np.testing.assert_array_equal(mq.orbit_basis(p, H), expected_basis)
+                self.assertEqual(mq.canonical_histogram(p, expected_C),
+                                 mq.canonical_histogram(199, expected_C))
+                self.assertEqual(mq.mean_trace(p, K, np.int64(2), expected_C),
+                                 mq.mean_trace(199, 11, 2, expected_C))
+                np.testing.assert_array_equal(mq.orbit_matrix(p, H, np.int64(1)),
+                                              mq.orbit_matrix(199, expected_H, 1))
+                np.testing.assert_array_equal(H, before)
+
+    def test_reported_overflow_and_q_representatives(self):
+        p, K, m = 199, 11, 2
+        H = mq.subgroup(p, K, 139)
+        C = mq.word_histogram(p, H, m)
+        expected = mq.histogram_trace(p, K, m, 1, C)
+        matrix = mq.orbit_matrix(p, H, 1)
+        variants = (
+            1, 1-p, 1+p*10**80, 1-p*10**80,
+            np.int64(1+p*2**50), np.int64(1-p*2**50),
+            np.uint64(1+p*2**50), np.uint64(1+p*2**56),
+        )
+        for q in variants:
+            with self.subTest(q=repr(q)), warnings.catch_warnings():
+                warnings.simplefilter("error", RuntimeWarning)
+                self.assertEqual(mq.histogram_trace(p, K, m, q, C), expected)
+                np.testing.assert_array_equal(mq.orbit_matrix(p, H, q), matrix)
+                self.assertLess(abs(np.trace(matrix @ matrix)-expected), 1e-12)
+
+    def test_gauge_index_and_q_representatives(self):
+        expected = mq.gauss_real_gauge(self.p, self.log, self.indices, 1)
+        for indices in (
