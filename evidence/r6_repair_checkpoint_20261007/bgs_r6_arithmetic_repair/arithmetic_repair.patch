+                ("sqrt.prime", lambda: tj.square_roots_mod_prime(5, bad)),
+                ("sqrt_alias.value", lambda: tj.sqrt_mod(bad, 199)),
+                ("design.prime", lambda: tj.find_design_eigenvalue(bad, 11)),
+                ("design.order", lambda: tj.find_design_eigenvalue(199, bad)),
+                ("design.trace", lambda: tj.find_design_eigenvalue(199, 11, bad)),
+                ("closed.prime", lambda: tj.build_closed_form(bad, 11, 139, 0, True, [1])),
+                ("closed.order", lambda: tj.build_closed_form(199, bad, 139, 0, True, [1])),
+                ("closed.eigenvalue", lambda: tj.build_closed_form(199, 11, bad, 0, True, [1])),
+                ("closed.residue", lambda: tj.build_closed_form(199, 11, 139, bad, True, [1])),
+                ("closed.q", lambda: tj.build_closed_form(199, 11, 139, 0, True, [bad])),
+            )
+            for name, call in cases:
+                with self.subTest(value=repr(bad), argument=name):
+                    with self.assertRaisesRegex(ValueError, "must be an integer"):
+                        call()
+
+    def test_square_roots_independent_finite_oracle(self):
+        checked = 0
+        for p in (3, 5, 7, 11, 13, 17, 31, 199):
+            for value in range(p):
+                expected = [x for x in range(p) if x*x % p == value]
+                for representative in (value, value+p*10**80, value-p*10**80, np.int64(value)):
+                    with self.subTest(p=p, value=representative):
+                        self.assertEqual(tj.square_roots_mod_prime(representative, np.int64(p)), expected)
+                        checked += 1
+        self.assertEqual(checked, 4*286)
+
+    def test_numpy_design_and_trace_representatives(self):
+        for trace in (3, np.int64(3), 3+199*10**80, 3-199*10**80):
+            result = tj.find_design_eigenvalue(np.int64(199), np.int64(11), trace)
+            self.assertEqual(result, 139)
+            self.assertIs(type(result), int)
+
+    def test_closed_form_representatives_and_bool_parity(self):
+        q_values = (
+            np.int64(1), np.int64(1+199*2**50), np.int64(1-199*2**50),
+            np.uint64(1+199*2**56), 1+199*10**80, 1-199*10**80,
+        )
+        for odd in (True, False):
+            expected, dimension = tj.build_closed_form(199, 11, 139, 0, odd, [1])
+            for eigenvalue, residue in ((np.int64(139), np.int64(0)),
+                                       (139+199*10**80, 11*10**80),
+                                       (139-199*10**80, -11*10**80)):
+                # Check each q separately: dictionary overwrite of congruent
+                # representatives must not hide an earlier wrong phase.
+                for q in q_values:
+                    with self.subTest(odd=odd, eigenvalue=eigenvalue, residue=residue, q=repr(q)):
+                        observed, size = tj.build_closed_form(np.int64(199), np.int64(11),
+                                                             eigenvalue, residue, odd, [q])
+                        self.assertEqual(size, dimension)
+                        self.assertEqual(observed, expected)
+                batch, _ = tj.build_closed_form(199, 11, eigenvalue, residue, odd, q_values)
+                self.assertEqual(batch, expected)
+            numpy_odd, _ = tj.build_closed_form(199, 11, 139, 0, np.bool_(odd), [1])
+            self.assertEqual(numpy_odd, expected)
+
+    def test_odd_parity_requires_a_boolean(self):
+        for value in (0, 1, np.int64(0), np.int64(1), 0.0, 1.0,
+                      np.float64(1.0), "True", "False", None):
+            with self.subTest(odd_parity=repr(value)):
+                with self.assertRaisesRegex(ValueError, "odd_parity must be a boolean"):
+                    tj.build_closed_form(199, 11, 139, 0, value, [1])
+
+    def test_invalid_design_domains(self):
+        for p in (0, -199, 2, 9):
+            for call in (
+                lambda: tj.square_roots_mod_prime(5, p),
+                lambda: tj.find_design_eigenvalue(p, 11),
+                lambda: tj.build_closed_form(p, 11, 139, 0, True, [1]),
+            ):
+                with self.assertRaises(ValueError):
+                    call()
+        for K in (0, -11, 7):
+            with self.assertRaises(ValueError):
+                tj.find_design_eigenvalue(199, K)
+            with self.assertRaises(ValueError):
+                tj.build_closed_form(199, K, 139, 0, True, [1])
+        for eigenvalue in (0, 1, 3):
+            with self.assertRaises(ValueError):
+                tj.build_closed_form(199, 11, eigenvalue, 0, True, [1])
+        with self.assertRaisesRegex(ValueError, "safe int64 product bound"):
+            tj.build_closed_form(ja.MAX_VECTORIZED_PRIME+1, 11, 139, 0, True, [1])
