+                        np.testing.assert_array_equal(observed, wanted)
+
+    def test_dense_histogram_finite_agreement(self):
+        # Exactly 117 (p, K, m, q) cases; direct dense matrix powers, not an
+        # eigenvalue trace or reuse of the word enumerator's recurrence.
+        checked = 0
+        for p, K, orders, q_values in (
+            (7, 3, range(1, 5), range(1, 7)),
+            (31, 5, range(1, 4), range(1, 31)),
+            (199, 11, [2], [1, 2, 198]),
+        ):
+            h = pow(primitive_root(p), (p-1)//K, p)
+            H = mq.subgroup(p, K, h)
+            for m in orders:
+                C = mq.word_histogram(p, H, m)
+                for q in q_values:
+                    with self.subTest(p=p, K=K, m=m, q=q):
+                        direct = np.trace(np.linalg.matrix_power(mq.orbit_matrix(p, H, q), m))
