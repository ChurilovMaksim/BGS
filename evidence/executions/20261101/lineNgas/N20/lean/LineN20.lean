def seedIdx : Nat := 15*31 + 15
theorem fw_closed : fstep FW = FW ∧ FW.testBit seedIdx = true := by decide +kernel
theorem bw_closed : bstep BW = BW ∧ BW.testBit seedIdx = true := by decide +kernel
/-- depth tables agree with the bitmasks -/
theorem fw_table : (List.range 961).all (fun s => FW.testBit s == Nat.blt (tget DFW (s/31) (s%31)) 99) = true := by
  decide +kernel
theorem bw_table : (List.range 961).all (fun s => BW.testBit s == Nat.blt (tget DBW (s/31) (s%31)) 99) = true := by
  decide +kernel
/-- forward depth certificate: s = (b,c) at depth d ≥ 1 has a predecessor (a,b), a → allowed, at depth d − 1 -/
theorem fw_depth : (List.range 31).all (fun b => (List.range 31).all (fun c =>
    let d := tget DFW b c
    Nat.beq d 99 || Nat.beq d 0 && Nat.beq b 15 && Nat.beq c 15 ||
    (Nat.blt 0 d && (List.range 31).any (fun a => okb a b c && Nat.beq (tget DFW a b + 1) d)))) = true := by
  decide +kernel
/-- backward depth certificate: s = (a,b) at depth d ≥ 1 has a successor (b,c) at depth d − 1 -/
theorem bw_depth : (List.range 31).all (fun a => (List.range 31).all (fun b =>
    let d := tget DBW a b
    Nat.beq d 99 || Nat.beq d 0 && Nat.beq a 15 && Nat.beq b 15 ||
    (Nat.blt 0 d && (List.range 31).any (fun c => okb a b c && Nat.beq (tget DBW b c + 1) d)))) = true := by
  decide +kernel
def REACH : Nat := FW &&& BW
def popc (F : Nat) : Nat := (List.range 961).foldl (fun acc s => if F.testBit s then acc + 1 else acc) 0
def inner (F : Nat) : Bool := (List.range 961).all (fun s => !F.testBit s ||
  (Nat.ble 1 (s/31) && Nat.ble (s/31) 29 && Nat.ble 1 (s%31) && Nat.ble (s%31) 29))
